<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!--
    INCLUDE SPRING BOOT DEFAULTS
    This gives us pre-configured patterns and properties from Spring Boot
  -->
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <!--
    PROPERTIES: Define variables used throughout the config
    These can be overridden by environment variables or Spring properties
  -->
  <property name="APP_NAME" value="railway-auth-service"/>
  <property name="LOG_PATH" value="${LOG_PATH:-logs}"/>
  <property name="PROFILE" value="${spring.profiles.active:-dev}"/>

  <!-- ========================================== -->
  <!-- CONSOLE APPENDER (Development) -->
  <!-- ========================================== -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger{40}) - %msg%n</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- ========================================== -->
  <!-- FILE APPENDER (All Logs) -->
  <!-- ========================================== -->
  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_PATH}/${APP_NAME}-${PROFILE}.log</file>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{40} - %msg%n</pattern>
      <charset>UTF-8</charset>
    </encoder>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_PATH}/archive/${APP_NAME}-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>100MB</maxFileSize>
      <maxHistory>30</maxHistory>
      <totalSizeCap>3GB</totalSizeCap>
      <cleanHistoryOnStart>true</cleanHistoryOnStart>
    </rollingPolicy>
  </appender>

  <!-- ========================================== -->
  <!-- ERROR FILE APPENDER (Errors Only) -->
  <!-- ========================================== -->
  <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_PATH}/${APP_NAME}-${PROFILE}-error.log</file>
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>ERROR</level>
    </filter>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{40} - %msg%n%ex{full}</pattern>
      <charset>UTF-8</charset>
    </encoder>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_PATH}/archive/${APP_NAME}-error-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>50MB</maxFileSize>
      <maxHistory>60</maxHistory>
      <totalSizeCap>1GB</totalSizeCap>
    </rollingPolicy>
  </appender>

  <!-- ========================================== -->
  <!-- JSON APPENDER (Production - for Loki/ELK) -->
  <!-- ========================================== -->
  <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_PATH}/${APP_NAME}-${PROFILE}-json.log</file>
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <customFields>{"app":"${APP_NAME}"}</customFields>
      <includeCallerData>false</includeCallerData>
      <includeMdcKeyName>traceId</includeMdcKeyName>
      <includeMdcKeyName>spanId</includeMdcKeyName>
    </encoder>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_PATH}/archive/${APP_NAME}-json-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>100MB</maxFileSize>
      <maxHistory>30</maxHistory>
      <totalSizeCap>3GB</totalSizeCap>
    </rollingPolicy>
  </appender>

  <!-- ========================================== -->
  <!-- ASYNC APPENDERS (Performance Optimization) -->
  <!-- ========================================== -->
  <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
    <appender-ref ref="FILE"/>
    <queueSize>512</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <includeCallerData>false</includeCallerData>
  </appender>

  <appender name="ASYNC_ERROR" class="ch.qos.logback.classic.AsyncAppender">
    <appender-ref ref="ERROR_FILE"/>
    <queueSize>256</queueSize>
    <discardingThreshold>0</discardingThreshold>
  </appender>

  <appender name="ASYNC_JSON" class="ch.qos.logback.classic.AsyncAppender">
    <appender-ref ref="JSON_FILE"/>
    <queueSize>512</queueSize>
    <discardingThreshold>0</discardingThreshold>
  </appender>

  <!-- ========================================== -->
  <!-- DEVELOPMENT PROFILE -->
  <!-- ========================================== -->
  <springProfile name="dev,local">
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
      <appender-ref ref="FILE"/>
    </root>

    <!-- Your application packages -->
    <logger name="com.railway.auth_service" level="DEBUG" additivity="false">
      <appender-ref ref="CONSOLE"/>
      <appender-ref ref="FILE"/>
    </logger>

    <!-- Spring framework -->
    <logger name="org.springframework.web" level="DEBUG" additivity="false">
      <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Database SQL queries -->
    <logger name="org.hibernate.SQL" level="DEBUG" additivity="false">
      <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- SQL parameters (very verbose) -->
    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="TRACE" additivity="false">
      <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Transaction management -->
    <logger name="org.springframework.transaction" level="DEBUG" additivity="false">
      <appender-ref ref="CONSOLE"/>
    </logger>
  </springProfile>

  <!-- ========================================== -->
  <!-- PRODUCTION PROFILE -->
  <!-- ========================================== -->
  <springProfile name="prod">
    <root level="INFO">
      <appender-ref ref="ASYNC_FILE"/>
      <appender-ref ref="ASYNC_ERROR"/>
      <appender-ref ref="ASYNC_JSON"/>
    </root>

    <!-- Your application -->
    <logger name="com.railway.auth_service" level="INFO" additivity="false">
      <appender-ref ref="ASYNC_FILE"/>
      <appender-ref ref="ASYNC_ERROR"/>
      <appender-ref ref="ASYNC_JSON"/>
    </logger>

    <!-- Spring framework - only warnings -->
    <logger name="org.springframework" level="WARN" additivity="false">
      <appender-ref ref="ASYNC_FILE"/>
      <appender-ref ref="ASYNC_ERROR"/>
    </logger>

    <!-- Hibernate - no SQL in prod -->
    <logger name="org.hibernate" level="WARN" additivity="false">
      <appender-ref ref="ASYNC_FILE"/>
      <appender-ref ref="ASYNC_ERROR"/>
    </logger>

    <!-- Security events - track authentication -->
    <logger name="org.springframework.security" level="INFO" additivity="false">
      <appender-ref ref="ASYNC_FILE"/>
      <appender-ref ref="ASYNC_JSON"/>
    </logger>

    <!-- Database connection pool -->
    <logger name="com.zaxxer.hikari" level="INFO" additivity="false">
      <appender-ref ref="ASYNC_FILE"/>
    </logger>
  </springProfile>

  <!-- ========================================== -->
  <!-- TEST PROFILE -->
  <!-- ========================================== -->
  <springProfile name="test">
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
    </root>

    <logger name="com.railway.auth_service" level="DEBUG" additivity="false">
      <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Suppress noisy test logs -->
    <logger name="org.springframework.test" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
  </springProfile>

</configuration>
