<?xml version="1.0" encoding="UTF-8"?>

<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <property name="APP_NAME" value="train-booking"/>
  <property name="LOG_PATH" value="${LOG_PATH:-logs}"/>
  <property name="LOG_FILE" value="${LOG_FILE:-${LOG_PATH}/${APP_NAME}.log}"/>

  <!--
      CONSOLE APPENDER: Outputs logs to console (terminal/stdout)
      Used in development for easy debugging
  -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <!--
        ENCODER: Formats the log message
        Pattern explanation:
        - %d{yyyy-MM-dd HH:mm:ss.SSS} = Date and time with milliseconds
        - [%thread] = Thread name in brackets
        - %highlight(%-5level) = Log level (INFO, ERROR, etc.) with color
        - %cyan(%logger{36}) = Logger name (class) in cyan, max 36 chars
        - %msg = The actual log message
        - %n = New line
    -->
    <encoder>
      <pattern>
        %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger{36}) - %msg%n
      </pattern>
      <!-- CHARACTER ENCODING: Ensures proper display of special characters -->
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!--
      FILE APPENDER: Writes logs to a file with rotation
      Automatically creates new files when size limit is reached
  -->
  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <!-- FILE: Current active log file location -->
    <file>${LOG_FILE}</file>

    <!--
        ENCODER: Same as console but without colors
        (Colors don't work in files and add extra characters)
    -->
    <encoder>
      <pattern>
        %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
      </pattern>
      <charset>UTF-8</charset>
    </encoder>

    <!--
        ROLLING POLICY: When to create new log files
        - SizeAndTimeBasedRollingPolicy: Rotates based on BOTH size and time
    -->
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <!--
          FILE NAME PATTERN: Format for archived logs
          - %d{yyyy-MM-dd} = Date (creates one file per day)
          - %i = Index number (if multiple files in same day)
          - .gz = Compress the file to save disk space

          Example: train-booking-2025-01-21.0.log.gz
      -->
      <fileNamePattern>${LOG_PATH}/${APP_NAME}-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>

      <!-- MAX FILE SIZE: When one file reaches 100MB, create a new one -->
      <maxFileSize>100MB</maxFileSize>

      <!-- MAX HISTORY: Keep logs for 30 days, delete older files -->
      <maxHistory>30</maxHistory>

      <!-- TOTAL SIZE CAP: Maximum total size of all log files (1GB) -->
      <totalSizeCap>1GB</totalSizeCap>

      <!-- CLEAN HISTORY ON START: Remove old logs when app starts -->
      <cleanHistoryOnStart>true</cleanHistoryOnStart>
    </rollingPolicy>
  </appender>

  <!--
      ERROR FILE APPENDER: Separate file for ERROR level logs only
      Makes it easy to find problems without searching through all logs
  -->
  <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_PATH}/${APP_NAME}-error.log</file>

    <!--
        FILTER: Only allow ERROR and above (ERROR, FATAL)
        Rejects everything else (INFO, DEBUG, WARN)
    -->
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>ERROR</level>
    </filter>

    <encoder>
      <pattern>
        %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
      </pattern>
      <charset>UTF-8</charset>
    </encoder>

    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_PATH}/${APP_NAME}-error-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>50MB</maxFileSize>
      <maxHistory>60</maxHistory>
      <totalSizeCap>500MB</totalSizeCap>
    </rollingPolicy>
  </appender>

  <!--
      JSON APPENDER: Outputs logs in JSON format
      Used for log aggregation tools (ELK, Grafana Loki, CloudWatch)
      Makes logs machine-readable and easier to search/analyze

      REQUIRES: net.logstash.logback:logstash-logback-encoder dependency
  -->
  <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_PATH}/${APP_NAME}-json.log</file>

    <!--
        LOGSTASH ENCODER: Formats logs as JSON
        Each log line becomes a JSON object with structured fields

        Example output:
        {"@timestamp":"2025-01-21T10:30:45.123Z","level":"INFO","logger":"com.railway.auth_service","message":"User logged in","app":"train-booking"}
    -->
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <!-- CUSTOM FIELDS: Add extra fields to every log entry -->
      <customFields>{"app":"${APP_NAME}","environment":"prod"}</customFields>

      <!-- INCLUDE CALLER DATA: Add file name and line number (expensive, use carefully) -->
      <includeCallerData>false</includeCallerData>

      <!-- PRETTY PRINT: Format JSON with indentation (only for dev/debugging) -->
      <jsonGeneratorDecorator class="net.logstash.logback.decorate.PrettyPrintingJsonGeneratorDecorator"/>
    </encoder>

    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_PATH}/${APP_NAME}-json-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>100MB</maxFileSize>
      <maxHistory>30</maxHistory>
      <totalSizeCap>1GB</totalSizeCap>
    </rollingPolicy>
  </appender>

  <!--
      ASYNC APPENDER: Improves performance by logging asynchronously
      Puts log messages in a queue and writes them in a separate thread
      This prevents logging from slowing down your application
  -->
  <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
    <!-- APPENDER REF: Which appender to wrap (make async) -->
    <appender-ref ref="FILE"/>

    <!--
        QUEUE SIZE: Max number of log events in the queue
        If queue fills up, behavior depends on discardingThreshold
    -->
    <queueSize>512</queueSize>

    <!--
        DISCARDING THRESHOLD: When queue is 80% full, start dropping TRACE/DEBUG/INFO
        Set to 0 to never discard (might slow down app if logging too much)
    -->
    <discardingThreshold>0</discardingThreshold>

    <!--
        INCLUDE CALLER DATA: Add file/line info (expensive)
        Usually false for performance
    -->
    <includeCallerData>false</includeCallerData>
  </appender>

  <!-- ASYNC ERROR FILE: Same as above but for error logs -->
  <appender name="ASYNC_ERROR" class="ch.qos.logback.classic.AsyncAppender">
    <appender-ref ref="ERROR_FILE"/>
    <queueSize>256</queueSize>
    <discardingThreshold>0</discardingThreshold>
  </appender>

  <!-- ASYNC JSON FILE: Same as above but for JSON logs -->
  <appender name="ASYNC_JSON" class="ch.qos.logback.classic.AsyncAppender">
    <appender-ref ref="JSON_FILE"/>
    <queueSize>512</queueSize>
    <discardingThreshold>0</discardingThreshold>
  </appender>

  <!--
      SPRING PROFILES: Different configurations for different environments
      Uses Spring Boot's active profile (dev, prod, test)
  -->

  <!--
      DEV PROFILE: Development environment
      - Logs to console for easy viewing
      - DEBUG level for detailed information
      - Shows SQL queries
      - More verbose logging
  -->
  <springProfile name="dev,local">
    <!--
        ROOT LOGGER: Default logger for everything
        level="DEBUG" means log everything from DEBUG and above
    -->
    <root level="DEBUG">
      <!-- APPENDER REF: Where to send the logs -->
      <appender-ref ref="CONSOLE"/>
      <appender-ref ref="FILE"/>
    </root>

    <!--
        PACKAGE-SPECIFIC LOGGERS: Custom log levels for specific packages
        These override the root level for matching classes
    -->

    <!-- Your application code: DEBUG level (most verbose) -->
    <logger name="com.railway.auth_service" level="DEBUG" additivity="false">
      <appender-ref ref="CONSOLE"/>
      <appender-ref ref="FILE"/>
    </logger>

    <!-- Spring Framework: DEBUG (see what Spring is doing) -->
    <logger name="org.springframework" level="DEBUG" additivity="false">
      <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Show SQL queries: DEBUG -->
    <logger name="org.hibernate.SQL" level="DEBUG" additivity="false">
      <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Show SQL parameters: TRACE (most detailed) -->
    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="TRACE" additivity="false">
      <appender-ref ref="CONSOLE"/>
    </logger>
  </springProfile>

  <!--
      PROD PROFILE: Production environment
      - Minimal console output
      - Writes to files (async for performance)
      - JSON logs for monitoring tools
      - Only INFO and above (less verbose)
      - Separate error log file
  -->
  <springProfile name="prod">
    <!-- ROOT: INFO level (less verbose than DEBUG) -->
    <root level="INFO">
      <appender-ref ref="ASYNC_FILE"/>
      <appender-ref ref="ASYNC_ERROR"/>
      <appender-ref ref="ASYNC_JSON"/>
    </root>

    <!-- Your application: INFO level -->
    <logger name="com.railway.auth_service" level="INFO" additivity="false">
      <appender-ref ref="ASYNC_FILE"/>
      <appender-ref ref="ASYNC_ERROR"/>
      <appender-ref ref="ASYNC_JSON"/>
    </logger>

    <!-- Spring: WARN level (only warnings and errors) -->
    <logger name="org.springframework" level="WARN" additivity="false">
      <appender-ref ref="ASYNC_FILE"/>
      <appender-ref ref="ASYNC_ERROR"/>
    </logger>

    <!-- Hibernate: WARN level (don't show SQL in prod) -->
    <logger name="org.hibernate" level="WARN" additivity="false">
      <appender-ref ref="ASYNC_FILE"/>
      <appender-ref ref="ASYNC_ERROR"/>
    </logger>

    <!-- Security: INFO level (track auth events) -->
    <logger name="org.springframework.security" level="INFO" additivity="false">
      <appender-ref ref="ASYNC_FILE"/>
      <appender-ref ref="ASYNC_JSON"/>
    </logger>
  </springProfile>

  <!--
      TEST PROFILE: Testing environment
      - Console output only
      - INFO level (not too verbose)
      - No file logging
  -->
  <springProfile name="test">
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
    </root>

    <logger name="com.railway.auth_service" level="DEBUG" additivity="false">
      <appender-ref ref="CONSOLE"/>
    </logger>
  </springProfile>

  <!--
      ADDITIVITY EXPLAINED:
      - additivity="false": Logger only uses its own appenders
      - additivity="true" (default): Logger uses its own + parent's appenders

      Example with additivity="true":
      If logger uses FILE and root uses CONSOLE,
      logs will go to BOTH FILE and CONSOLE (duplicated)

      Setting to "false" prevents duplication
  -->

</configuration>

  <!--
      ============================================
      SUMMARY OF LOG LEVELS (from most to least verbose):
      ============================================

      TRACE   - Very detailed, step-by-step execution
      DEBUG   - Detailed information for debugging
      INFO    - General informational messages
      WARN    - Warning messages, potential issues
      ERROR   - Error messages, something went wrong
      FATAL   - Critical errors, app might crash

      ============================================
      FILE STRUCTURE THIS CREATES:
      ============================================

      logs/
      ├── train-booking.log                    # Current log file (all logs)
      ├── train-booking-error.log              # Current error log
      ├── train-booking-json.log               # Current JSON log
      ├── train-booking-2025-01-21.0.log.gz   # Archived daily log
      ├── train-booking-2025-01-20.0.log.gz   # Previous day
      └── train-booking-error-2025-01-21.0.log.gz  # Archived errors

      ============================================
      HOW TO USE:
      ============================================

      1. Create file: src/main/resources/logback-spring.xml
      2. Copy this content
      3. Add dependency to pom.xml:
         <dependency>
             <groupId>net.logstash.logback</groupId>
             <artifactId>logstash-logback-encoder</artifactId>
             <version>7.4</version>
         </dependency>

      4. Run with profile:
         # Development
         mvn spring-boot:run -Dspring.profiles.active=dev

         # Production
         mvn spring-boot:run -Dspring.profiles.active=prod

      5. View logs:
         # Real-time
         tail -f logs/train-booking.log

         # Errors only
         tail -f logs/train-booking-error.log

         # JSON logs
         tail -f logs/train-booking-json.log
  -->
